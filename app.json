{
  "expo": {
    "name": "Agile Athletes",
    "slug": "oq-agile-athletes",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "oqagileathletes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oqagileathletes.app",
      "buildNumber": "5",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:agile-athletes.expo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Allow $(PRODUCT_NAME) to access your device motion to count steps",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload profile pictures and select exercise videos.",
        "NSCameraUsageDescription": "Allow Agile Athletes to record exercise videos for AI form analysis.",
        "NSMicrophoneUsageDescription": "Allow Agile Athletes to record audio with exercise videos.",
        "NSCalendarsUsageDescription": "Agile Athletes adds your booked local group sessions to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Agile Athletes adds your booked local group sessions to your calendar.",
        "NSRemindersUsageDescription": "Agile Athletes can remind you about upcoming group sessions.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "api-oq-agile-athletes.onrender.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kroniumtech.agileathletes",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "agile-athletes.expo.app",
              "pathPrefix": "/connections"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "react-native-google-mobile-ads": {
      "androidAppId": "ca-app-pub-1234567890123456~1234567890",
      "iosAppId": "ca-app-pub-6910383646275801~7240069060"
    },
    "plugins": [
      "./plugins/withGoogleMapsFromEnv.js",
      "./plugins/withGoogleSignInIosScheme.js",
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "reactNativeArchitectures": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access your device motion to count steps"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Agile Athletes to use your location to find nearby trainers and set your gym area."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Agile Athletes adds your booked local group sessions to your calendar.",
          "remindersPermission": "Agile Athletes can remind you about upcoming group sessions."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6910383646275801~2215962774",
          "iosAppId": "ca-app-pub-6910383646275801~7240069060"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2a5ef5f-f13a-48c2-85a7-b58c5a68ffd0"
      }
    }
  }
}